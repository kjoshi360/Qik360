generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  MANAGER
  AGENT
}

enum Plan {
  FREE
  PRO
  ENTERPRISE
}

model tenant {
  id               String             @id @default(cuid())
  name             String
  plan             Plan               @default(FREE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  users            user[]
  whatsappAccounts whatsapp_account[]
  conversations    conversation[]
  subscriptions    subscription[]
  usageLogs        usage_log[]
  aiSettings       ai_setting[]
  knowledgeBases   knowledge_base[]
  automations      automation[]
}

model user {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  role         Role
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model whatsapp_account {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         tenant   @relation(fields: [tenantId], references: [id])
  phoneNumberId  String
  encryptedToken String
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model conversation {
  id          String    @id @default(cuid())
  tenantId    String
  tenant      tenant    @relation(fields: [tenantId], references: [id])
  customerRef String
  status      String
  createdAt   DateTime  @default(now())
  messages    message[]
}

model message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   conversation @relation(fields: [conversationId], references: [id])
  sender         String
  content        String
  createdAt      DateTime     @default(now())
}

model ai_setting {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    tenant   @relation(fields: [tenantId], references: [id])
  model     String
  prompt    String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model knowledge_base {
  id        String            @id @default(cuid())
  tenantId  String
  tenant    tenant            @relation(fields: [tenantId], references: [id])
  name      String
  entries   knowledge_entry[]
  createdAt DateTime          @default(now())
}

model knowledge_entry {
  id              String         @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   knowledge_base @relation(fields: [knowledgeBaseId], references: [id])
  question        String
  answer          String
  createdAt       DateTime       @default(now())
}

model automation {
  id         String   @id @default(cuid())
  tenantId   String
  tenant     tenant   @relation(fields: [tenantId], references: [id])
  name       String
  n8nFlowId  String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model subscription {
  id             String   @id @default(cuid())
  tenantId       String
  tenant         tenant   @relation(fields: [tenantId], references: [id])
  provider       String
  providerRef    String
  plan           Plan
  status         String
  currentPeriod  DateTime
  createdAt      DateTime @default(now())
}

model usage_log {
  id        String   @id @default(cuid())
  tenantId  String
  tenant    tenant   @relation(fields: [tenantId], references: [id])
  metric    String
  quantity  Int
  createdAt DateTime @default(now())
}
